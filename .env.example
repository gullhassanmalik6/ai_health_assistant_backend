# -----------------------------------------------------------------------------
# AI Doctor Backend — environment template
# Copy this file to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------------

# development | staging | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=AI Doctor API
APP_VERSION=1.0.0

# SQLAlchemy async URL
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://aidoctor:aidoctor@localhost:5432/aidoctor

# Dedicated test database — never point this at production
TEST_DATABASE_URL=postgresql+asyncpg://aidoctor:aidoctor@localhost:5432/aidoctor_test

# -----------------------------------------------------------------------------
# Firebase Authentication
# Prefer FIREBASE_CREDENTIALS_PATH (service account JSON) in production.
# Alternatively supply individual fields from the service account file.
# FIREBASE_API_KEY is the Web API key from Firebase project settings
# (used for Identity Toolkit REST: login, reset, anonymous sign-in).
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY=your-firebase-web-api-key

# Optional: path to the downloaded service account JSON (overrides individual fields)
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-adminsdk.json

# Optional: raw JSON string of the service account (overrides individual fields)
# FIREBASE_CREDENTIALS_JSON=

# -----------------------------------------------------------------------------
# HTTP
# Comma-separated origins. Do NOT use * in production.
# Flutter web / future Next.js origins go here.
# Native Android/iOS apps do not send Origin; CORS mainly affects web.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Comma-separated hostnames. Use * only in local development.
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate limit (requests per minute per IP). In-memory; swap for Redis later.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
